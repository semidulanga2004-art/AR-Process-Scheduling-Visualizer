  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::QuizManager
  welcomePanel: {fileID: 2075950742}
  questionPanel: {fileID: 1562129574}
  resultPanel: {fileID: 369466049}
  questionNumberText: {fileID: 696883840}
  questionText: {fileID: 694985558}
  answerButtons:
  - {fileID: 2092510056}
  - {fileID: 459068795}
  - {fileID: 885964281}
  - {fileID: 558949104}
  answerButtonTexts:
  - {fileID: 1037633585}
  - {fileID: 1027413924}
  - {fileID: 1296920018}
  - {fileID: 1498023452}
  feedbackText: {fileID: 1015586114}
  nextButton: {fileID: 1671650111}
  progressBar: {fileID: 1107802557}
  scoreText: {fileID: 779732707}
  percentageText: {fileID: 795917029}
  messageText: {fileID: 1401980848}
  bibiResult: {fileID: 2110324434}
  resultAudioSource: {fileID: 1270916343}
  excellentWorkAudio: {fileID: 8300000, guid: b97de49f9edcd39478023cbaf58675ea, type: 3}
  goodJobAudio: {fileID: 8300000, guid: b0ce7df0ac4361c47ae749f35a2b96ca, type: 3}
  tryAgainAudio: {fileID: 8300000, guid: 2021d47dc615ac145a6928e80a385d19, type: 3}
  questions:
  - questionText: Q1. Which process scheduling algorithm executes processes in the
      order they arrive in the ready queue?
    answers:
    - A. SJF
    - B. FCFS
    - C. Round Robin
    - D. Priority Scheduling
    correctAnswer: 1
  - questionText: Q2. What is a major disadvantage of FCFS scheduling?
    answers:
    - A. Starvation
    - B. Frequent context switching
    - C. Convoy effect
    - D. Requires a time quantum
    correctAnswer: 2
  - questionText: Q3. Which process is selected first in Shortest Job First scheduling?
    answers:
    - A. Process with the shortest burst time
    - B. Process with the longest burst time
    - C. Process with the highest arrival time
    - D. Process with the lowest process ID
    correctAnswer: 0
  - questionText: Q4. In non-preemptive SJF scheduling, what happens once a process
      starts execution?
    answers:
    - A. It is immediately interrupted
    - B. It runs until completion
    - C. It receives a time quantum
    - D. It returns to the ready queue
    correctAnswer: 1
  - questionText: Q5. What is the main feature of Round Robin scheduling?
    answers:
    - A. Processes execute according to priority
    - B. Processes execute according to burst time
    - C. Each process receives a fixed time quantum
    - D. The first arriving process executes completely
    correctAnswer: 2
  - questionText: Q6. What happens when a process does not finish within its allocated
      time quantum?
    answers:
    - A. It is terminated
    - B. It goes to the end of the ready queue
    - C. It gets the CPU permanently
    - D. It is removed from the system
    correctAnswer: 1
  - questionText: Q7. How are processes selected in Priority Scheduling?
    answers:
    - A. Based on arrival time only
    - B. Based on burst time only
    - C. Based on their assigned priority
    - D. Randomly
    correctAnswer: 2
  - questionText: Q8. What problem can occur when low-priority processes wait indefinitely?
    answers:
    - A. Starvation
    - B. Deadlock
    - C. Paging
    - D. Thrashing
    correctAnswer: 0
  - questionText: Q9. What does SRTF stand for?
